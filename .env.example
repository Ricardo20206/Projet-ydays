# Configuration Flask
SECRET_KEY=your-secret-key-here-change-in-production

# Configuration Email (Gmail)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# API Externe (optionnel)
API_BASE_URL=http://localhost:5001

# Kling AI API (optionnel)
KLING_API_KEY=your-kling-api-key-here
KLING_API_URL=https://api.klingai.com

# URL publique pour Kling (ngrok ou domaine de production)
PUBLIC_BASE_URL=https://your-domain.vercel.app
